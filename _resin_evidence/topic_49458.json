{"post_stream":{"posts":[{"id":108331,"name":"Keagan W Stephens","username":"Keagan_W_Stephens","avatar_template":"/user_avatar/forum.creality.com/keagan_w_stephens/{size}/34232_2.png","created_at":"2026-03-11T08:54:45.656Z","cooked":"\u003cp\u003eHello Everyone!\u003c/p\u003e\n\u003cp\u003eMy name is Keagan Stephens, all the way from SA!\u003c/p\u003e\n\u003cp\u003eI am 31 years old ,I Live in Eshowe Kwa-Zulu natal 3815 (ZULULAND!) and i Am a Qualified Post Basic Pharmacist Assistant And the owner of Sculptured Realities. My 3d printing Journey Started about 6months ago when i was trying to find a way to make a toy replica of my daughter and had asked a friend of mine whom if fortunate enough to own a Creality Ender KE. I Loved the results and got the cheapest 3d printer i could find which i still use today (easythreed k9 and k10). this was 5 months ago , since then I saved up to get a Creality Halot r6 WHICH WAS ON SALE AT THE TIME. I Really loved the quality prints i got from the Halot R6 and decided to open a business based around 3d Prints specifically aiming to  make life like busts that resemble clients likeness, which has gone amazingly well especially since i’ve been unemployed for the past 2 years due to a major unemployment rate the country is facing .\u003c/p\u003e\n\u003cp\u003esince starting i’ve been working with our local bakers trying to fill in the gap by bringing affordable cake toppers and baking related tools such as cookie cutters and stencils etc(we live in a remote area)..i am also currently working on fun kids theme pot planters ,lamps and articulated toys ,keychains and much more which i believe will get kids to get excited about 3d printing and nature as a whole.\u003c/p\u003e\n\u003cp\u003eMy future goals for myself and my company is to move on to larger life sized 3d printing aswell as move on to automotive 3d printing applications (mainly engine and interior trimming aswell as afew designer parts). We also aim to start 3d printing lessons for kids which require more high speed printers as so we can print small mini objects evert session which wont take aslong as they do on my current fdm printers.\u003c/p\u003e\n\u003cp\u003eMy hopes for this forum and journey as a whole would be to learn more on 3d printing applications and related software, improve my designing skills aswell as simply just to get inspired on my next design.\u003c/p\u003e\n\u003cp\u003eI am also here to learn more about Creality as a brand and  Make and hopefully become a pioneer of the brand in future.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":1,"updated_at":"2026-03-11T08:54:45.656Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":18,"reads":1,"readers_count":0,"score":90.2,"yours":false,"topic_id":49458,"topic_slug":"hello-everyone","display_username":"Keagan W Stephens","primary_group_name":"CREALITY-MAKER-ELITE","flair_name":"CREALITY-MAKER-ELITE","flair_url":"/uploads/default/original/3X/c/6/c62e6bbadb416554475bd7230958084685b3460e.png","flair_bg_color":"","flair_color":"","flair_group_id":51,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Creality Maker","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":36260,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"mentioned_users":[],"post_url":"/t/hello-everyone/49458/1","can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false}],"stream":[108331]},"timeline_lookup":[[1,246]],"user_badges":{"users":{"36260":{"id":36260,"badge_ids":[101]}},"badges":{"101":{"id":101,"name":"Licensed","slug":"licensed","description":"Completed our advanced user tutorial","icon":"stamp","image_url":null,"badge_grouping_id":1,"